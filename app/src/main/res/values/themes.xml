<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-first shell while the UI is rebuilt slice by slice; the Compose theme owns colors. -->
    <style name="Theme.Auroro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/auroro_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
