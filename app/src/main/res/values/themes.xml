<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Auroro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/auroro_deep_ocean</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Auroro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/auroro_deep_ocean</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Auroro</item>
    </style>
</resources>
